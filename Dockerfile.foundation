FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-foundation.lock ./
RUN pip install --no-cache-dir -r requirements-foundation.lock && useradd --uid 10001 --create-home operator
COPY foundation /app/foundation
COPY migrations /app/migrations
COPY alembic.ini /app/alembic.ini
USER operator
EXPOSE 8090
CMD ["uvicorn","foundation.api:create_app","--factory","--host","0.0.0.0","--port","8090","--no-access-log","--limit-concurrency","32","--timeout-keep-alive","5"]
